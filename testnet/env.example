NODE_NAME=XF_MasterNode
CONTACT_DETAILS=YOUR_EMAIL_ADDRESS
NETWORK=testnet
LOG_LEVEL=2

# Sync & storage
# SYNC_MODE: full (default) or fast (requires pivot point below)
SYNC_MODE=full
# Fast-sync pivot point (auto-populated by start-wizard.sh when SYNC_MODE=fast; leave blank for full sync)
FASTSYNC_PIVOT_NUMBER=
FASTSYNC_PIVOT_HASH=
FASTSYNC_PIVOT_ROOT=
# GC_MODE: archive (default, keeps all historical state) or full (prunes old state to save disk)
GC_MODE=full
# STORE_REWARD: true (stores epoch reward data) or false (default, disables reward storage to save disk)
STORE_REWARD=false
# CHAIN_CONFIG_MISMATCH_POLICY: update-config-only (default, writes the new chain config without rewinding), exit, rewind-and-update or ignore-mismatch
CHAIN_CONFIG_MISMATCH_POLICY=update-config-only
# PEER_WHITELIST: true (default, only peer with the enodes in whitelist.list when it lists any) or false (ignore whitelist.list)
PEER_WHITELIST=true
# PEER_WHITELIST_HUB: set true only on the hub node listed in whitelist.list, so it accepts inbound peers from any IP (discovery stays off)
PEER_WHITELIST_HUB=false

# API setting (RPC & WebSocket)
ENABLE_RPC=false
ENABLE_WS=false
API=db,eth,net,txpool,web3,XDPoS
ALLOWED_ORIGINS=*
RPC_VHOSTS=*
RPC_PORT=8545
WS_PORT=8546
