INSTANCE_NAME=YOUR_NODE_NAME
CONTACT_DETAILS=YOUR_EMAIL_ADDRESS
# Network label sent to Loki: mainnet | testnet | devnet
NETWORK=mainnet
# XDC / XDPoSChain release tag and git commit of the running binary/image
NODE_VERSION=v2.7.0
NODE_COMMIT=unknown
LOG_LEVEL=2

# Loki log shipping (Fluent Bit sidecar; set ENABLE_LOKI_LOGS=true)
ENABLE_LOKI_LOGS=false
LOKI_HOST=loki.devnet.xinfin.org
LOKI_PORT=443
LOKI_URI=/loki/api/v1/push
LOKI_TLS=on
LOKI_TLS_VERIFY=on
# Basic auth required by nginx proxy in front of Loki
LOKI_USER=
LOKI_PASSWORD=

# AIOps — POST /api/deployments once at docker-up.sh startup
AIOPS_SERVICE_URL=https://aiops.devnet.xinfin.org

# Sync & storage
# SYNC_MODE: full (default) or fast (requires pivot point below)
SYNC_MODE=full
# Fast-sync pivot point (auto-populated by start-wizard.sh when SYNC_MODE=fast; leave blank for full sync)
FASTSYNC_PIVOT_NUMBER=
FASTSYNC_PIVOT_HASH=
FASTSYNC_PIVOT_ROOT=
# GC_MODE: archive (default, keeps all historical state) or full (prunes old state to save disk)
GC_MODE=full
# STORE_REWARD: true (stores epoch reward data) or false (default, disables reward storage to save disk)
STORE_REWARD=false

# API setting (RPC & WebSocket)
ENABLE_RPC=false
ENABLE_WS=false
API=db,eth,net,txpool,web3,XDPoS
ALLOWED_ORIGINS=*
RPC_VHOSTS=*
RPC_PORT=8989
WS_PORT=8888
