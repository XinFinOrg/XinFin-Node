# Nethermind config preset baked into the image (configs/<NETWORK>.json)
NETWORK=xdc-testnet
EC_IMAGE_VERSION=nethermindeth/nethermind:master-c88b947
# Log level: trace, debug, info, warn, error
NETHERMIND_LOG_LEVEL=info
# Host directory for chain data
EC_DATA_DIR=./execution-data

# Sync & storage
# SYNC_MODE: fast (default, starts from a pivot block) or full (executes every block from genesis)
SYNC_MODE=fast
# Fast-sync pivot point (leave all blank to use the pivot built into the image)
FASTSYNC_PIVOT_NUMBER=
FASTSYNC_PIVOT_HASH=
FASTSYNC_PIVOT_TOTAL_DIFFICULTY=
# GC_MODE: full (default, prunes old state to save disk) or archive (keeps all state from where the sync starts)
GC_MODE=full

# RPC settings
RPC_PORT=8505
# RPC_MODULES: comma-separated JSON-RPC namespaces to enable
#Available: Eth,Net,Web3,Xdc,Health,Rpc,Subscribe,Proof,TxPool,Parity,Trace,Debug,Evm,Admin,Personal
# Avoid on a public port: Parity, Evm, Admin, Personal (node control) and Trace, Debug (heavy tracing)
# Add Rpc to use the XDC console (XDC attach)
RPC_MODULES=Eth,Net,Web3,Xdc,Health
